<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Workspace" referent="RBX00000001"><Properties><string name="Name">Workspace</string></Properties></Item><Item class="ReplicatedStorage" referent="RBX00000003"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="ModuleScript" referent="RBX00000002"><Properties><string name="Name">DeepDiveConfig</string><ProtectedString name="Source"><![CDATA[--[[
	DeepDiveConfig  (ModuleScript)
	LOCATION: ReplicatedStorage > DeepDiveConfig

	This is the ONE file for balancing the game. Prices, part stats, zones,
	monsters and loot all live here. Both the server and the client read it.
	Change a number here and it changes everywhere.
]]

local Config = {}

Config.GameName = "Deep Dive"
Config.Version = "1.0"

------------------------------------------------------------------------
-- WORLD
------------------------------------------------------------------------
-- The sea surface sits high in the sky so the deep ocean never reaches
-- Roblox's "fallen parts" kill height. 1 stud = 1 metre of depth.
Config.SURFACE_Y = 1000
Config.SurfaceDepth = 6 -- shallower than this counts as "surfaced"

Config.Ocean = {
	MinX = -430,
	MaxX = 430,
	MinZ = -120,
	MaxZ = 840,
}

Config.Zones = {
	{
		Name = "Sunlit Reef",
		Min = 0,
		Max = 200,
		Color = Color3.fromRGB(95, 215, 255),
		MonsterMult = 1.0,
	},
	{
		Name = "Twilight Drop",
		Min = 200,
		Max = 600,
		Color = Color3.fromRGB(110, 120, 255),
		MonsterMult = 1.5,
	},
	{
		Name = "Midnight Trench",
		Min = 600,
		Max = 1500,
		Color = Color3.fromRGB(150, 70, 200),
		MonsterMult = 2.2,
		Locked = true,
	},
}

function Config.GetZone(depth)
	for i, zone in ipairs(Config.Zones) do
		if depth < zone.Max then
			return zone, i
		end
	end
	return Config.Zones[#Config.Zones], #Config.Zones
end

